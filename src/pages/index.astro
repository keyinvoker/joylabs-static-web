---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
const phone = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
const waNumber = phone.replace(/\D/g, '');
const email = import.meta.env.PUBLIC_EMAIL_ADDRESS || '';
const rawPaymentLink = import.meta.env.PUBLIC_MIDTRANS_PAYMENT_LINK || '';
const paymentUrl = (() => {
  try {
    const url = new URL(rawPaymentLink);
    return url.protocol === 'https:' && (url.hostname.endsWith('.midtrans.com') || url.hostname === 'midtrans.com' || url.hostname.endsWith('.midtrans.co.id') || url.hostname === 'midtrans.co.id') && url.pathname !== '/' ? url.href : '';
  } catch { return ''; }
})();
const paymentLink = paymentUrl;
const address = import.meta.env.PUBLIC_BUSINESS_ADDRESS || 'West Jakarta, DKI Jakarta';
const whatsapp = waNumber.length >= 8 ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Hi JoyLabs, I would like to discuss a software project.')}` : '';
const hasContactMethod = Boolean(whatsapp || email);
const services = [
  { title: 'Landing Page Website', description: 'A focused, responsive static website that makes your business easy to understand and contact.', example: 'Business introduction, product launch', price: 'Rp3.500.000' },
  { title: 'Custom Web Application', description: 'A purpose-built application shaped around your team’s real processes and needs.', example: 'Internal tools, customer portals', price: 'Rp250.000/hour' },
  { title: 'Admin Dashboard', description: 'A calmer place to monitor operations, find information, and take action.', example: 'Operations, reporting, user admin', price: 'Rp250.000/hour' },
  { title: 'Inventory Management System', description: 'Keep products, stock movements, and low-stock items in one useful workspace.', example: 'Retail, wholesale, stock rooms', price: 'Rp250.000/hour' },
  { title: 'E-commerce Application', description: 'A tailored storefront and order workflow designed around your products.', example: 'Catalogs, ordering, fulfillment', price: 'Rp250.000/hour' },
  { title: 'UI/UX Dashboard Design', description: 'Clear application interfaces, from early flows and wireframes to polished UI.', example: 'New products, workflow redesign', price: 'Rp250.000/hour' },
  { title: 'API & System Integration', description: 'Connect services and data so everyday workflows need less manual handoff.', example: 'Third-party APIs, existing systems', price: 'Rp250.000/hour' },
  { title: 'Bug Fixing & Maintenance', description: 'Investigate issues, improve existing software, and handle agreed maintenance work.', example: 'Websites, apps, dashboards', price: 'Rp250.000/hour' },
];
const faqs = [
  ['How much does a custom application cost?', 'Custom development is Rp250.000 per hour. The final project price depends on the agreed scope and estimated working hours.'],
  ['How is the final project price calculated?', 'We first discuss your goals and requirements, then outline the scope, estimated hours, timeline, and price for your approval.'],
  ['Do you build inventory management systems?', 'Yes. Inventory systems can include product lists, stock status, low-stock alerts, summaries, and workflows fitted to your business.'],
  ['Can you create an admin dashboard?', 'Yes. We design and build dashboards around the information and actions your team needs.'],
  ['Do you build e-commerce applications?', 'Yes. We can discuss a storefront, product catalog, ordering workflow, and other needs for your business.'],
  ['Do you provide domain and hosting?', 'The Landing Page Website service includes a domain name and hosting for one year. Other project arrangements are discussed in the proposal.'],
  ['How does payment work?', 'Once the scope and price are agreed, JoyLabs sends a Midtrans Payment Link. You complete payment on the Midtrans-hosted payment page.'],
  ['How long does a project take?', 'Timing depends on the agreed scope and project requirements. We include an estimated timeline in the proposal before work starts.'],
  ['Can I request maintenance or bug fixes?', 'Yes. Maintenance and bug fixing are available at Rp250.000 per hour, with the work agreed before it begins.'],
];
---
<Layout>
  <main id="main">
    <section id="top" class="hero anchor">
      <div class="hero-grid shell">
        <div class="hero-copy">
          <div class="hero-kicker"><img src="/joylabs-logo-mark.png" alt="" width="34" height="34" /> <span class="live-dot"></span> Independent software studio · West Jakarta</div>
          <h1>Software that<br />works <span class="gradient-text">beautifully.</span></h1>
          <p class="hero-lead">Modern websites, web applications, and custom dashboards for businesses that want better digital tools.</p>
          <div class="hero-actions"><a class="btn btn-primary" href="#contact">Start a project <span aria-hidden="true">↗</span></a><a class="btn btn-secondary" href="#services">Explore services <span aria-hidden="true">↓</span></a></div>
          <div class="hero-proof"><div class="proof-avatars" aria-hidden="true"><span>W</span><span>A</span><span>↗</span></div><p>Thoughtful digital tools,<br /><strong>built around your workflow.</strong></p></div>
        </div>
        <div class="hero-art" aria-label="Concept illustration of a modern inventory dashboard" role="img">
          <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
          <div class="dashboard-window">
            <div class="dash-top"><div class="dash-brand"><span class="mini-mark">J</span><span>studio / inventory</span></div><div class="dash-top-right"><span class="dash-pill">● Live overview</span><span class="dash-avatar">JL</span></div></div>
            <div class="dash-body"><aside class="dash-sidebar"><div class="side-active"><i>▦</i> Overview</div><div><i>□</i> Products</div><div><i>↗</i> Orders</div><div><i>◷</i> Activity</div><div><i>⚙</i> Settings</div><div class="side-bottom"><span></span> All systems normal</div></aside>
              <div class="dash-main"><div class="dash-title"><div><small>MONDAY, 23 SEPTEMBER</small><b>Good morning, team <span>✳</span></b></div><button>＋ Add product</button></div>
                <div class="metric-row"><div class="metric"><small>Total products</small><b>—</b><span>↗ Product catalog</span></div><div class="metric"><small>In stock</small><b>—</b><span class="good">● Stock overview</span></div><div class="metric warning"><small>Need attention</small><b>—</b><span class="warn">● Review stock</span></div></div>
                <div class="dash-content-row"><div class="chart-box"><div class="chart-heading"><span>Stock movement</span><small>Last 7 days⌄</small></div><div class="chart-value">Stock movement <span>Illustrative chart</span></div><svg class="chart" viewBox="0 0 400 130" preserveAspectRatio="none" aria-label="Illustrative stock movement chart without real business data"><defs><linearGradient id="fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#26e4bf" stop-opacity=".25"/><stop offset="1" stop-color="#26e4bf" stop-opacity="0"/></linearGradient></defs><path d="M0 95 C30 82 45 91 73 66 S118 77 145 51 S188 72 220 48 S266 65 292 38 S334 51 360 27 S384 38 400 17 V130 H0Z" fill="url(#fill)"/><path d="M0 95 C30 82 45 91 73 66 S118 77 145 51 S188 72 220 48 S266 65 292 38 S334 51 360 27 S384 38 400 17" fill="none" stroke="#20e6b8" stroke-width="2.5"/></svg><div class="chart-days"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span><span>SUN</span></div></div>
                  <div class="alerts-box"><div class="chart-heading">Stock alerts <small>Sample alert state</small></div><div class="alert-item"><i>!</i><span><b>Sample product A</b><small>Needs stock review</small></span><em>Reorder</em></div><div class="alert-item"><i>!</i><span><b>Sample product B</b><small>Needs stock review</small></span><em>Reorder</em></div><div class="alert-item"><i class="ok">✓</i><span><b>Sample product C</b><small>Stock updated</small></span></div></div></div>
                <div class="product-strip"><div class="strip-heading"><b>Recently updated products</b><span>View products →</span></div><div class="product-row"><span class="product-icon mint">◈</span><b>Sample product A</b><span>SKU-001</span><strong class="stock-low">Review status</strong><span>Today</span></div><div class="product-row"><span class="product-icon blue">▧</span><b>Sample product B</b><span>SKU-002</span><strong class="stock-good">Sample status</strong><span>Today</span></div></div>
              </div>
            </div>
            <div class="dash-note"><span>✦</span> A possible product direction <i>Concept interface</i></div>
          </div>
          <div class="float-tag tag-stock"><span>↗</span><div><b>Stock at a glance</b><small>Less digging, more doing</small></div></div>
          <div class="float-tag tag-spark"><span>✳</span><div><b>A little more human</b><small>Designed with care</small></div></div>
        </div>
      </div>
      <div class="hero-bottom shell"><span>MADE FOR THE WAY YOUR BUSINESS WORKS</span><div><i>✳</i> Clearer workflows <i>✳</i> Better tools <i>✳</i> Less busywork</div></div>
    </section>

    <section class="intro-section anchor" id="about"><div class="shell intro-grid"><div><span class="eyebrow">A different kind of software studio</span><h2 class="section-title">Making admin dashboards <span class="gradient-text">less boring.</span></h2></div><div class="intro-right"><p class="section-copy">Business software should feel like it belongs to your business. JoyLabs builds practical digital tools with thoughtful design, clear workflows, and the details that make work feel easier.</p><div class="values"><span>Easy to use</span><span>More organized</span><span>Made for your workflow</span><span>A little more joyful</span></div></div></div></section>

    <section id="services" class="services-section anchor"><div class="shell"><div class="section-heading"><div><span class="eyebrow">What we can build together</span><h2 class="section-title">A good fit for your<br /><span class="gradient-text">next big idea.</span></h2></div><p class="section-copy">From a clear first impression to the software behind the scenes. Start with one service, then shape the right scope together.</p></div><div class="services-grid">{services.map((service, index) => <ServiceCard index={`0${index + 1}`} {...service} />)}</div><p class="pricing-note"><strong>Custom quote based on project scope.</strong> Custom software is billed at <strong>Rp250.000/hour</strong>. The final project price is confirmed after reviewing the agreed scope and estimated working hours.</p></div></section>

    <section id="work" class="showcase-section anchor"><div class="shell"><div class="section-heading"><div><span class="eyebrow">A glimpse of what’s possible</span><h2 class="section-title">Ideas, made <span class="gradient-text">tangible.</span></h2></div><p class="section-copy">These are sample interfaces and example product directions, created to show how a solution could take shape.</p></div><div class="showcase-grid">
      <article class="show-card inventory-show"><div class="show-visual inventory-mini"><div class="mini-sidebar"><span class="mini-logo">J.</span><span class="selected">▦</span><span>□</span><span>↗</span><span>⚙</span></div><div class="mini-dashboard"><div class="mini-nav"><b>Inventory overview</b><span>⌕ &nbsp; ◉</span></div><div class="mini-stats"><i><small>Products</small><b>—</b></i><i><small>Low stock</small><b class="amber">—</b></i><i><small>Stock value</small><b>—</b></i></div><div class="mini-content"><div class="mini-chart"><span>Movement over time</span><svg viewBox="0 0 200 55"><path d="M0 43 Q22 25 42 35T80 22T115 31T145 12T175 19T200 5" fill="none" stroke="#28dcf6" stroke-width="2"/><path d="M0 43 Q22 25 42 35T80 22T115 31T145 12T175 19T200 5" fill="none" stroke="#28dcf6" stroke-width="8" opacity=".1"/></svg></div><div class="mini-alert"><b>Needs a top-up</b><span>Sample product A <i>Review</i></span><span>Sample product B <i>Review</i></span></div></div><div class="mini-list"><span>Product</span><span>SKU</span><span>Status</span><span>Sample product A</span><span>SKU-001</span><em>Review status</em><span>Sample product B</span><span>SKU-002</span><em class="green">In stock</em></div></div></div><div class="show-caption"><div><span class="concept-label">CONCEPT PROJECT</span><h3>Inventory, in view.</h3><p>A calmer way to follow products, movement, and stock alerts.</p></div><span class="show-arrow">↗</span></div></article>
      <article class="show-card storefront-show"><div class="show-visual storefront-mini"><div class="store-nav"><b>fieldnotes<span>.</span></b><span>Shop&nbsp;&nbsp; Our story&nbsp;&nbsp; Bag (0)</span></div><div class="store-hero"><div><small>OBJECTS FOR EVERYDAY</small><b>Useful things,<br />made to last.</b><button>Explore the collection&nbsp; ↗</button></div><div class="store-object"><div class="object-shape"></div><span>FORM / 01</span></div></div><div class="store-thumbs"><i>Everyday carry</i><i>At home</i><i>Thoughtful gifts</i></div></div><div class="show-caption"><div><span class="concept-label">SAMPLE DESIGN</span><h3>A storefront with a point of view.</h3><p>Product discovery with a considered digital home.</p></div><span class="show-arrow">↗</span></div></article>
      <article class="show-card ops-show"><div class="show-visual ops-mini"><div class="ops-header"><b>Good morning, team <span>✳</span></b><small>Today at a glance</small></div><div class="ops-tiles"><div><i>◷</i><small>Open tasks</small><b>—</b></div><div><i class="teal">↗</i><small>Needs review</small><b>—</b></div><div><i class="purple">✓</i><small>Completed today</small><b>—</b></div></div><div class="ops-bottom"><span>Weekly activity</span><div class="bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div><div class="show-caption"><div><span class="concept-label">DEMO INTERFACE</span><h3>Operations at a glance.</h3><p>One tidy dashboard for the work happening today.</p></div><span class="show-arrow">↗</span></div></article>
      <article class="show-card landing-show"><div class="show-visual landing-mini"><div class="landing-nav"><b>goodkind<span>®</span></b><span>What we do&nbsp;&nbsp;&nbsp; About&nbsp;&nbsp;&nbsp; <i>Let’s talk ↗</i></span></div><div class="landing-hero"><span>MAKE ROOM FOR GOOD WORK</span><b>Good ideas<br />deserve a <i>good home.</i></b><small>We help thoughtful teams turn the next idea into something real.</small><i class="sun-graphic">✳</i></div><div class="landing-bottom"><span>Thoughtfully built for the next chapter.</span><span>Scroll to explore ↓</span></div></div><div class="show-caption"><div><span class="concept-label">SAMPLE DESIGN</span><h3>A landing page that feels like you.</h3><p>A focused first impression for a growing business.</p></div><span class="show-arrow">↗</span></div></article>
    </div><p class="concept-disclaimer">Illustrative concepts only. These visuals are not presented as completed client projects.</p></div></section>

    <section id="pricing" class="pricing-section anchor"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Clear starting points</span><h2 class="section-title">Straightforward pricing.<br /><span class="gradient-text">No mystery math.</span></h2></div><p class="section-copy">Every project starts with a conversation. You’ll see the scope, estimated effort, timeline, and price before approving the work.</p></div><div class="price-grid"><article class="price-card card"><div class="price-overline"><span>01 / QUICK START</span><span class="price-dot"></span></div><h3>Landing Page<br />Website</h3><p class="price-desc">A polished, responsive static website to introduce your business.</p><div class="price-amount">Rp3.500.000 <small>one-time</small></div><ul><li><span>✓</span> Static landing page website</li><li><span>✓</span> Responsive design</li><li><span>✓</span> Domain name</li><li><span>✓</span> Hosting for 1 year</li></ul><a class="btn btn-secondary" href="#contact">Request this service <span>↗</span></a></article>
        <article class="price-card price-featured card"><div class="price-overline"><span>02 / BUILT AROUND YOU</span><span class="featured-tag">FLEXIBLE SCOPE</span></div><h3>Custom Software<br />Development</h3><p class="price-desc">A tailored application, dashboard, or improvement for your business.</p><div class="price-amount">Rp250.000 <small>/ hour</small></div><ul><li><span>✓</span> Admin dashboards & inventory apps</li><li><span>✓</span> E-commerce & workflow systems</li><li><span>✓</span> API integrations & UI/UX</li><li><span>✓</span> Bug fixing & maintenance</li></ul><p class="scope-note">Final project price depends on the agreed scope and estimated working hours.</p><a class="btn btn-primary" href="#contact">Talk through your idea <span>↗</span></a></article></div><p class="price-footnote">All amounts are in Indonesian rupiah (IDR). Custom work begins after the proposal and price are approved.</p></div></section>

    <section id="process" class="process-section anchor"><div class="shell process-grid"><div class="process-intro"><span class="eyebrow">From hello to handoff</span><h2 class="section-title">A clear path<br />from <span class="gradient-text">idea to done.</span></h2><p class="section-copy">You’ll know what’s happening, what it costs, and what comes next before the build begins.</p><a class="text-link" href="#contact">Tell us what you have in mind <span>↗</span></a></div><ol class="steps"><li><span>01</span><div><b>Explore the services</b><p>Find a useful starting point in the JoyLabs service catalog.</p></div></li><li><span>02</span><div><b>Get in touch</b><p>Reach out through WhatsApp or the contact form.</p></div></li><li><span>03</span><div><b>Talk through the need</b><p>We discuss your goals, requirements, and current workflow.</p></div></li><li><span>04</span><div><b>Receive a proposal</b><p>See the scope, estimated hours, timeline, and price.</p></div></li><li><span>05</span><div><b>Approve the scope</b><p>We begin once you’re happy with the proposed work.</p></div></li><li><span>06</span><div><b>Get a Midtrans Payment Link</b><p>JoyLabs sends a payment link for the agreed amount.</p></div></li><li><span>07</span><div><b>Complete payment</b><p>Pay on the Midtrans-hosted payment page.</p></div></li><li><span>08</span><div><b>Development begins</b><p>We build the approved website, application, or service.</p></div></li><li><span>09</span><div><b>Review the result</b><p>You review the agreed deliverable with JoyLabs.</p></div></li><li><span>10</span><div><b>Receive your delivery</b><p>JoyLabs hands over the completed agreed service.</p></div></li></ol></div></section>

    <section id="payment" class="payment-section anchor"><div class="shell payment-card"><div class="payment-icon"><span>↗</span></div><div class="payment-text"><span class="eyebrow">A simple, secure next step</span><h2>How payment works</h2><p>After the project scope and price are agreed, JoyLabs sends a Midtrans Payment Link. Customers can complete the payment securely through the Midtrans-hosted payment page.</p><div class="payment-assurance"><span>✓</span> Your proposal comes before payment</div></div><div class="payment-action">{paymentLink ? <a class="btn btn-primary" href={paymentLink} target="_blank" rel="noreferrer">Open payment link ↗</a> : <span class="payment-unavailable" aria-disabled="true">Payment link shared after proposal</span>}<small>{paymentLink ? 'Use this link only for the agreed proposal.' : 'No payment link is configured for this site.'}</small></div></div></section>

    <section id="faq" class="faq-section anchor"><div class="shell faq-grid"><div><span class="eyebrow">Good questions</span><h2 class="section-title">A few things<br /><span class="gradient-text">you might wonder.</span></h2><p class="section-copy">Have a different question? We’re happy to talk it through.</p><a class="text-link" href="#contact">Ask JoyLabs directly <span>↗</span></a></div><div class="faq-list">{faqs.map(([question, answer], index) => <details class="faq-item" open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>

    <section id="contact" class="contact-section anchor"><div class:list={['shell contact-grid', !hasContactMethod && 'contact-grid-no-form']}><div class="contact-copy"><span class="eyebrow">Have a project in mind?</span><h2 class="section-title">Let’s make<br />something <span class="gradient-text">useful.</span></h2>{hasContactMethod && <p class="section-copy">Tell us a little about what you need. We’ll get back to you to talk through the next steps and a clear project scope.</p>}{(whatsapp || email) && <div class="contact-details">{whatsapp && <a class="contact-detail" href={whatsapp} target="_blank" rel="noreferrer"><span class="detail-icon">↗</span><div><small>WHATSAPP</small><b>{phone}</b></div><span class="detail-arrow">↗</span></a>}{email && <a class="contact-detail" href={`mailto:${email}`}><span class="detail-icon">@</span><div><small>EMAIL</small><b>{email}</b></div><span class="detail-arrow">↗</span></a>}</div>}<div class="contact-detail contact-location"><span class="detail-icon">⌖</span><div><small>LOCATION</small><b>{address}</b></div></div></div>
      {hasContactMethod && <form id="project-form" class="contact-form card"><div class="form-heading"><span>START A CONVERSATION</span><i>✳</i></div><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required minlength="2" placeholder="How should we call you?" /><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" /><label for="service">What can we help with?</label><select id="service" name="service" required><option value="" disabled selected>Choose a service</option>{services.map(({ title }) => <option value={title}>{title}</option>)}</select><label for="message">A little about the project</label><textarea id="message" name="message" required minlength="12" rows="4" placeholder="What would you like your software to make easier?"></textarea><button type="submit" class="btn btn-primary form-submit">{waNumber.length >= 8 ? 'Continue with WhatsApp' : 'Continue with email'} <span aria-hidden="true">↗</span></button><p id="form-status" class="form-status" aria-live="polite">{waNumber.length >= 8 ? 'Your details will open as a pre-filled WhatsApp message for you to send.' : 'Your details will open in a pre-filled email for you to send.'}</p></form>}
    </div></section>
    <section class="closing-cta"><div class="shell closing-inner"><div><span class="eyebrow">A good tool changes the day.</span><h2>Let’s make your next<br />workday <span class="gradient-text">a little better.</span></h2></div><a class="btn btn-primary" href="#contact">Start a project <span>↗</span></a><div class="closing-orb" aria-hidden="true">✳</div></div></section>
  </main>
  <script define:vars={{ phone: waNumber, contactEmail: email }}>
    const projectForm = document.querySelector('#project-form');
    const status = document.querySelector('#form-status');
    document.querySelectorAll('[data-service]').forEach((link) => link.addEventListener('click', () => {
      const select = document.querySelector('#service'); if (select) select.value = link.dataset.service;
    }));
    projectForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!projectForm.reportValidity()) return;
      const data = new FormData(projectForm);
      const message = `Hi JoyLabs, I would like to discuss a software project.\n\nName: ${data.get('name')}\nEmail: ${data.get('email')}\nService: ${data.get('service')}\nProject details: ${data.get('message')}`;
      if (phone.length >= 8) {
        window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
        status.textContent = 'WhatsApp opened with your message. Review it there and press send to contact JoyLabs.';
      } else if (contactEmail) {
        window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent('Software project inquiry')}&body=${encodeURIComponent(message)}`;
        status.textContent = 'Your email app opened with a pre-filled message. Review and send it to contact JoyLabs.';
      }
      status.classList.remove('status-error');
    });
  </script>
</Layout>

