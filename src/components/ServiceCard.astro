---
const { index, title, description, example, price } = Astro.props;
---
<article class="service-card card">
  <div class="topline"><span class="index">{index}</span><span class="arrow" aria-hidden="true">↗</span></div>
  <h3>{title}</h3>
  <p class="description">{description}</p>
  <p class="example"><span>GOOD FOR</span>{example}</p>
  <div class="bottom"><p>{price}</p><a href="#contact" data-service={title} aria-label={`Discuss ${title} with JoyLabs`}>Discuss this service <span aria-hidden="true">↗</span></a></div>
</article>
<style>
 .service-card{padding:23px;display:flex;flex-direction:column;min-height:280px;transition:border-color .2s,transform .2s}.service-card:hover{border-color:rgba(32,230,184,.36);transform:translateY(-3px)}.topline{display:flex;justify-content:space-between;align-items:center}.index{color:#91a09c;font-size:.74rem;font-variant-numeric:tabular-nums}.arrow{color:#20e6b8;font-size:1.1rem}.service-card h3{font-size:1.2rem;letter-spacing:-.03em;margin:27px 0 9px}.description{font-size:.87rem;color:#adbbb6;line-height:1.6;margin:0}.example{display:flex;gap:8px;align-items:baseline;margin:18px 0;color:#e5eae5;font-size:.78rem}.example span{font-size:.61rem;letter-spacing:.09em;color:#82938e;font-weight:700;flex-shrink:0}.bottom{margin-top:auto;border-top:1px solid rgba(222,236,226,.1);padding-top:15px;display:flex;justify-content:space-between;align-items:center;gap:8px}.bottom p{font-weight:720;color:#20e6b8;font-size:.83rem;margin:0}.bottom a{font-size:.73rem;font-weight:650;color:#f5f7f3;white-space:nowrap}.bottom a span{color:#3aaeff}
</style>
