---
const { compact = false } = Astro.props;
---
<a class="brand" href="#top" aria-label="JoyLabs Software Studio home">
  <svg width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
    <rect width="42" height="42" rx="14" fill="#1D282A"/>
    <path d="m15.3 13.7-6 7.2 6 7.2m11.4-14.4 6 7.2-6 7.2" stroke="#C7FF83" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M17.4 25.7c2 2 5.2 2 7.2 0" stroke="#F5F7F3" stroke-width="2.3" stroke-linecap="round"/>
    <circle cx="16.8" cy="19.1" r="1.1" fill="#83E7E4"/><circle cx="25.2" cy="19.1" r="1.1" fill="#83E7E4"/>
  </svg>
  {!compact && <span class="brand-text">JoyLabs<span>Software Studio</span></span>}
</a>
<style>
  .brand{display:flex;align-items:center;gap:11px}.brand-text{font-size:1rem;line-height:1.1;font-weight:760;letter-spacing:-.03em}.brand-text span{display:block;color:#97a8a3;font-weight:500;font-size:.67rem;letter-spacing:.03em;margin-top:4px}
</style>
