---
const { compact = false } = Astro.props;
---
<a class="brand" href="#top" aria-label="JoyLabs Software Studio home">
  <img class="brand-mark" src="/joylabs-logo-mark.png" width="42" height="42" alt="" />
  {!compact && <span class="brand-text">JoyLabs<span>Software Studio</span></span>}
</a>
<style>
  .brand{display:flex;align-items:center;gap:11px}.brand-mark{width:42px;height:42px;object-fit:contain;flex:none}.brand-text{font-size:1rem;line-height:1.1;font-weight:760;letter-spacing:-.03em}.brand-text span{display:block;color:#a2b3d8;font-weight:500;font-size:.67rem;letter-spacing:.03em;margin-top:4px}
</style>
